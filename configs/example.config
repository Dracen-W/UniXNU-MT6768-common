# UniXNU-MT6768-common SoC example configuration (values intentionally blank).
# Board and OS configs (e.g. UniXNU-merlinx/configs/merlinx-iOS16.7.config) override these keys.
#
# Supported parameters:
#
# Enable MT6768 8-core SMP secondary bring-up (y | n; default: y).
CONFIG_XNU_DW_MT6768_SMP=

# Number of active CPU cores (integer; 1..8, default: 8 on MT6768/Helio G85).
CONFIG_XNU_DW_MT6768_CPUS=

# Drop secondary cores from EL2 to EL1 with SCTLR_EL1.SPAN=1 (y | n; default: y).
CONFIG_XNU_DW_MT6768_EL2_DROP=

# Clean TTEP / page tables before enabling MMU on secondary cores (y | n; default: y).
CONFIG_XNU_DW_MT6768_FLUSH_TTEP=

# Enable SMP workqueue parallelism on MT6768 (y | n; default: y).
CONFIG_XNU_DW_MT6768_WORKQUEUE_PARALLEL=
