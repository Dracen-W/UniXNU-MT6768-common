# Shared MT6768/MT6769Z kernel settings. Device profiles and OS override configs
# (e.g. configs/merlinx-iOS16.7.config) layer on top of this SoC baseline.
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

# Default MT6768 SoC DW parameters (overridable by board/OS config)
CONFIG_XNU_DW_MT6768_SMP=y
CONFIG_XNU_DW_MT6768_CPUS=8
CONFIG_XNU_DW_MT6768_EL2_DROP=y
CONFIG_XNU_DW_MT6768_FLUSH_TTEP=y
CONFIG_XNU_DW_MT6768_WORKQUEUE_PARALLEL=y
